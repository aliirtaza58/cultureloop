{
  "name": "cultureloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "dev:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev-local.ts",
    "services:check": "node scripts/dev-service.ts --check",
    "dev:services": "npm run services:check && npx --yes vercel@59.16.0 dev --local --listen 127.0.0.1:3017",
    "setup:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-local.ts",
    "build": "next build",
    "start": "next start",
    "setup:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-setup.ts",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-database.ts",
    "agent:dev": "eve dev",
    "agent:build": "eve build"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.93",
    "@electric-sql/pglite": "0.5.10",
    "ai": "7.0.137",
    "eve": "0.80.1",
    "just-bash": "3.6.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
