{
  "name": "cultureloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "demo": "node scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "qloo:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/probe-qloo.ts",
    "qloo:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-qloo.ts",
    "setup:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-setup.ts",
    "setup:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-setup.ts",
    "agent:dev": "eve dev",
    "agent:build": "eve build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "ai": "7.0.137",
    "eve": "0.80.1",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
