# Proposed server-side configuration. These are placeholders, not working credentials.
# Populate an ignored local environment file or the host's secret settings during setup.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Explicit provider selection. Google calls go directly to the Gemini Developer API.
CULTURELOOP_MODEL_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# See the README for the supported model and free-access setup.
GOOGLE_MODEL=

# Optional, explicitly selected Gateway route. No automatic provider fallback.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Private application database and guest-session signing secret.
DATABASE_URL=
# Use one CA source. Local file stays ignored; host the PEM as a server-only environment value.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
SESSION_SECRET=

# Local embedded PostgreSQL only. Never enable on Vercel.
CULTURELOOP_LOCAL_PROTOTYPE=false
# Enable only after checking the hosted database target and Free plan.
CULTURELOOP_HOSTED_DB_VERIFIED=false
# Exact public app origin for same-origin request validation; dev:local sets its own.
CULTURELOOP_APP_ORIGIN=
# Enable only after the intended account's free model access, eligibility and disabled top-ups are verified.
CULTURELOOP_FREE_AI_VERIFIED=false
